rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isTrade(data) {
      return data.keys().hasAll(['date', 'direction', 'entryPrice', 'exitPrice', 'stopLoss', 'lotSize',
                                   'session', 'setupType', 'mistakeTag', 'riskAmount', 'pnl', 'rMultiple',
                                   'emotionBefore', 'emotionDuring', 'emotionAfter', 'notes', 'createdAt'])
        && data.date is string
        && data.direction in ['Long', 'Short']
        && data.entryPrice is number && data.entryPrice > 0
        && data.exitPrice is number && data.exitPrice > 0
        && data.stopLoss is number && data.stopLoss > 0
        && data.lotSize is number && data.lotSize > 0
        && data.session in ['Asian', 'London', 'New York', 'Overlap']
        && data.setupType in ['Trend Continuation', 'Reversal', 'Range Breakout', 'Liquidity Sweep',
                               'News Fade', 'Support/Resistance', 'Other']
        && data.mistakeTag in ['None', 'Revenge Trade', 'Early Entry', 'Late Entry', 'Moved Stop',
                                 'Oversized', 'No Setup', 'FOMO', 'Ignored Checklist']
        && data.riskAmount is number
        && data.pnl is number
        && data.rMultiple is number
        && data.emotionBefore is number && data.emotionBefore >= 1 && data.emotionBefore <= 5
        && data.emotionDuring is number && data.emotionDuring >= 1 && data.emotionDuring <= 5
        && data.emotionAfter is number && data.emotionAfter >= 1 && data.emotionAfter <= 5
        && data.notes is string
        && data.createdAt is number;
    }

    function isChecklist(data) {
      return data.keys().hasAll(['items', 'biasNotes', 'keyLevels', 'completedAt'])
        && data.items is list
        && data.biasNotes is string
        && data.keyLevels is string
        && (data.completedAt == null || data.completedAt is number);
    }

    function isPsychology(data) {
      return data.keys().hasAll(['disciplineScore', 'moodScore', 'rulesFollowed', 'revengeTradeFlag', 'reflection'])
        && data.disciplineScore is number
        && data.moodScore is number
        && data.rulesFollowed is bool
        && data.revengeTradeFlag is bool
        && data.reflection is string;
    }

    function isPlaybookPage(data) {
      return data.keys().hasAll(['title', 'content', 'updatedAt', 'createdAt'])
        && data.title is string
        && data.content is string
        && data.updatedAt is number
        && data.createdAt is number;
    }

    function isRiskSettings(data) {
      return data.keys().hasAll(['accountBalance', 'riskPerTradePct', 'maxDailyLossPct', 'maxWeeklyLossPct'])
        && data.accountBalance is number
        && data.riskPerTradePct is number
        && data.maxDailyLossPct is number
        && data.maxWeeklyLossPct is number;
    }

    function isEconomicEvent(data) {
      return data.keys().hasAll(['date', 'time', 'title', 'impact'])
        && data.date is string
        && data.time is string
        && data.title is string
        && data.impact in ['Low', 'Medium', 'High'];
    }

    // /users/{uid}/trades/{tradeId}
    match /users/{uid}/trades/{tradeId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isTrade(request.resource.data);
    }

    // /users/{uid}/checklists/{dateId}
    match /users/{uid}/checklists/{dateId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isChecklist(request.resource.data);
    }

    // /users/{uid}/psychology/{dateId}
    match /users/{uid}/psychology/{dateId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isPsychology(request.resource.data);
    }

    // /users/{uid}/playbook/{pageId}
    match /users/{uid}/playbook/{pageId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isPlaybookPage(request.resource.data);
    }

    // /users/{uid}/riskSettings/config
    match /users/{uid}/riskSettings/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isRiskSettings(request.resource.data);
    }

    // /users/{uid}/economicEvents/{eventId}
    match /users/{uid}/economicEvents/{eventId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isEconomicEvent(request.resource.data);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
